# Copy to .env and fill in. .env is gitignored. Never commit real values.

# --- Test device (non-jailbroken iPhone XR) ---
TEST_DEVICE_UDID=          # from `idevice_id -l`
TEST_DEVICE_IP=            # XR IP on the test network

# --- Decrypt device (jailbroken iPhone 8) ---
DECRYPT_SSH_HOST=          # e.g. 192.168.1.50
DECRYPT_SSH_USER=root
DECRYPT_SSH_PORT=22
IPADECRYPT_CMD=ipadecrypt

# --- Proxyman ---
PROXYMAN_CLI=/Applications/Proxyman.app/Contents/MacOS/proxyman-cli
PROXYMAN_PORT=9090

# --- Signing (paths default to ../Certs and ../zsign) ---
SIGN_P12=../Certs/Certificates.p12
SIGN_P12_PASSWORD=
SIGN_PROFILE=../Certs/amir.mobileprovision
# SIGN_PEM=../Certs/dis.pem   # exported from the .p12 by instrument.py if absent

# --- Storage (external drive recommended) ---
IPA_DIR=./ipas
WORK_DIR=./work
RESULTS_DIR=./results
LOG_DIR=./logs

# --- Crawl ---
STOREFRONTS=us,gb,ca,cn,jp
CRAWL_COUNT_PER_CATEGORY=500

# --- AppFigures (optional; unlocks 500/category, needs a logged-in session cookie) ---
APPFIGURES_COOKIE=

# --- Acquisition ---
# ipadecrypt (default) or ipatool (ipatool downloads, ipadecrypt decrypts local file)
ACQUIRE_MODE=ipadecrypt
IPATOOL_CMD=ipatool
IPATOOL_EMAIL=
IPATOOL_PASSWORD=

# --- VPN rotation (optional, for IAP scan; needs sudo) ---
OPENVPN_DIR=../openvpn
OPENVPN_AUTH=../openvpn/auth.txt
