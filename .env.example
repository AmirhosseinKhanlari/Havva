# Copy to .env and fill in. .env is gitignored. Never commit real values.

# --- Test device (non-jailbroken iPhone XR) ---
TEST_DEVICE_UDID=          # from `idevice_id -l`
TEST_DEVICE_IP=            # XR IP on the test network

# --- Decrypt device (jailbroken iPhone 8) ---
DECRYPT_SSH_HOST=          # e.g. 192.168.1.50
DECRYPT_SSH_USER=root
DECRYPT_SSH_PORT=22
IPADECRYPT_CMD=ipadecrypt

# --- Proxyman ---
PROXYMAN_CLI=/Applications/Proxyman.app/Contents/MacOS/proxyman-cli
PROXYMAN_PORT=9090

# --- Signing (paths default to ../Certs and ../zsign) ---
SIGN_P12=../Certs/Certificates.p12
SIGN_P12_PASSWORD=
SIGN_PROFILE=../Certs/amir.mobileprovision
# SIGN_PEM=../Certs/dis.pem   # exported from the .p12 by instrument.py if absent

# --- Storage (external drive recommended) ---
IPA_DIR=./ipas
WORK_DIR=./work
RESULTS_DIR=./results
LOG_DIR=./logs

# --- Crawl ---
STOREFRONTS=us,gb,ca,cn,jp
CRAWL_COUNT_PER_CATEGORY=500

# --- AppFigures (optional; unlocks 500/category, needs a logged-in session cookie) ---
APPFIGURES_COOKIE=

# --- Acquisition ---
# ipadecrypt (default) or ipatool (ipatool downloads, ipadecrypt decrypts local file)
ACQUIRE_MODE=ipadecrypt
IPATOOL_CMD=ipatool
IPATOOL_EMAIL=
IPATOOL_PASSWORD=

# --- Offline FairPlay decryption (tools/fairplay-decrypt) ---
# Used first whenever the encrypted IPA is staged locally (ACQUIRE_MODE=appstore or
# ipatool) and its account has a credential; ipadecrypt is the fallback.
# Provision once per Apple account: python3 -m pipeline.cli fairplay-credential --ipa <encrypted.ipa>
# FAIRPLAY_OFFLINE=1                                   # 0 disables the offline path
# FAIRPLAY_DECRYPT_DIR=tools/fairplay-decrypt
# FAIRPLAY_CREDENTIALS_DIR=~/.fairplay-decrypt/credentials   # outside the repo, never commit
# FAIRPLAY_ROOT_KEY=~/.ssh/id_ed25519                  # root SSH key on the JB device (retrieval only)

# --- VPN rotation (optional, for IAP scan; needs sudo) ---
OPENVPN_DIR=../openvpn
OPENVPN_AUTH=../openvpn/auth.txt

# --- Appium (UI automation on the XR; WDA signing) ---
APPIUM_URL=http://127.0.0.1:4723
APPIUM_TEAM_ID=8CG9QYMSR5
APPIUM_SIGNING_ID=Apple Development
APPIUM_WDA_BUNDLE=com.amir.WebDriverAgentRunner

# --- Web UI (Satella Console) ---
WEB_AUTH_TOKEN=change-me-to-a-long-random-string
WEB_HOST=0.0.0.0
WEB_PORT=8770
WEB_MAX_WORKERS=3

# --- Gmail API for Google Voice OTP (phone-login automation) ---
# One-time: create an OAuth client, run consent, drop the token file in results/.
# Google Voice must be set to forward SMS to this Gmail inbox.
GMAIL_CREDENTIALS=results/gmail_credentials.json
GMAIL_TOKEN=results/gmail_token.json
GV_SENDER=voice.google.com
