decrypted/
captures/

# Python
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/

# macOS
.DS_Store

# ipadecrypt prebuilt binary (downloaded from releases)
tools/ipadecrypt
tools/checksums.txt

# vendored external MCP server (re-clone via git)
tools/vphone-mcp/

# DB backups (not matched by *.db) and exported UI design snapshots
*.db.bak*
design_export/

# Foreign repositories vendored for reference (each has its own .git); re-clone, never embed
mastg/
docs/My-iOS-Pentesting-Cheatsheet/
# Offline FairPlay decryptor (no upstream license: never commit it). Re-clone:
#   git clone https://github.com/EthanArbuckle/fairplay-decrypt tools/fairplay-decrypt
#   git -C tools/fairplay-decrypt checkout 0c952e15a705bf240a8ba6949c9e051b76624bdc
#   make -C tools/fairplay-decrypt
tools/fairplay-decrypt/

# Per-tweak build copies (the loadable copies live in the project root)
tweaks/*/*.dylib
